# Wallets to track: comma-separated name:venue:address
# venue is one of evm | safe | hyperliquid
SPARK_WALLETS="Hot Wallet:evm:0x...,Ledger:evm:0x...,Multisig:safe:0x...,Hyperliquid:hyperliquid:0x..."

# Wealthfolio agent token (Settings -> AI Agent Access).
# Read scopes suffice for reporting; draft+commit only if Spark should write.
SPARK_WF_TOKEN=

# Optional
# SPARK_WF_URL=https://wealthfolio.example.com
# SPARK_WF_DB_PATH=/data/wealthfolio.db
# SPARK_STATE_PATH=/state/spark.db
# SPARK_INTERVAL_MS=300000
# SPARK_TRACKING_START=2026-01-01
# SPARK_PORT=3000
